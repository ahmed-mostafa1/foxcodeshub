# ── Copy to .env and fill in values ───────────────────────────────────
# Dev defaults shown below; see production section at the bottom.

# ── Core ──────────────────────────────────────────────────────────────
DEBUG=true
SECRET_KEY=django-insecure-local-dev-key

# ── Hosts & CORS ──────────────────────────────────────────────────────
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_HOST=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=

# ── OAuth ─────────────────────────────────────────────────────────────
OAUTH_CLIENT_ID=local-dev-client-id
OAUTH_CLIENT_SECRET=local-dev-client-secret

# ── Email ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=support@foxcodeshub.com

# ── Social auth ───────────────────────────────────────────────────────
ENABLE_SOCIAL_AUTH=false
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_REDIRECT_IS_HTTPS=false

# ── PayPal ────────────────────────────────────────────────────────────
PAYPAL_USE_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_CLIENT_SECRET_LIVE=
PAYPAL_WEBHOOK_ID_LIVE=

# ── Cloudinary (omit / leave blank to use local media storage) ────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ══════════════════════════════════════════════════════════════════════
# PRODUCTION VALUES (replace all of the above in your server .env)
# ══════════════════════════════════════════════════════════════════════
# DEBUG=false
# SECRET_KEY=change-this-to-a-long-random-secret
# ALLOWED_HOSTS=api.foxcodeshub.com
# CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=https://foxcodeshub.com
# CSRF_TRUSTED_ORIGINS=https://api.foxcodeshub.com,https://foxcodeshub.com
# USE_X_FORWARDED_HOST=true
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# SECURE_HSTS_PRELOAD=true
# ENABLE_SOCIAL_AUTH=true
# SOCIAL_AUTH_REDIRECT_IS_HTTPS=true
# PAYPAL_USE_SANDBOX=false
