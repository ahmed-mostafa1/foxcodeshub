# Copy this file to `Backend/.env` for local development.
# Use placeholders only. Do not commit real secrets.

# Core
DEBUG=true
SECRET_KEY=django-insecure-local-dev-key

# Hosts and CORS
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
USE_X_FORWARDED_HOST=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# OAuth
OAUTH_CLIENT_ID=local-dev-client-id
OAUTH_CLIENT_SECRET=local-dev-client-secret

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
SUPPORT_EMAIL=support@foxcodeshub.com

# Social auth
ENABLE_SOCIAL_AUTH=false
SOCIAL_AUTH_FACEBOOK_KEY=
SOCIAL_AUTH_FACEBOOK_SECRET=
SOCIAL_AUTH_GOOGLE_OAUTH2_KEY=
SOCIAL_AUTH_GOOGLE_OAUTH2_SECRET=
SOCIAL_AUTH_REDIRECT_IS_HTTPS=false

# PayPal
PAYPAL_USE_SANDBOX=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID_LIVE=
PAYPAL_CLIENT_SECRET_LIVE=
PAYPAL_WEBHOOK_ID_LIVE=

# Stripe
# The current implementation uses hosted Stripe Checkout on the backend.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Frontend URL used by Stripe success/cancel redirects
FRONTEND_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production notes
# Set DEBUG=false
# Use live Stripe values:
# STRIPE_SECRET_KEY=sk_live_replace_me
# STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# FRONTEND_URL=https://foxcodeshub.com
